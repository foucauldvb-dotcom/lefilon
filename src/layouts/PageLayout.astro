---
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbSchema } from '../lib/seo';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  intro?: string;
}

const { title, description, intro } = Astro.props;
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: title, path: Astro.url.pathname },
];
---

<BaseLayout title={title} description={description} jsonLd={[breadcrumbSchema(crumbs)]}>
  <div class="container page">
    <Breadcrumb crumbs={crumbs} />
    <h1>{title}</h1>
    {intro && <p class="intro">{intro}</p>}
    <div class="content">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: calc(var(--largeur-texte) + 2 * var(--gouttiere));
    padding-block: 1.5rem 2rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2rem, 7vw, 3rem);
  }

  h1::after {
    content: '.';
    color: var(--or);
  }

  .intro {
    margin-top: 1rem;
    color: var(--gris);
    font-size: 1.125rem;
  }

  .content {
    margin-top: 2rem;
  }

  .content :global(> * + *) {
    margin-top: 1.25rem;
  }

  .content :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.375rem;
  }

  .content :global(a) {
    font-weight: 600;
    text-decoration-color: var(--or);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }

  .content :global(ul) {
    padding-left: 1.25rem;
  }

  .content :global(li + li) {
    margin-top: 0.5rem;
  }

  .content :global(.todo) {
    padding: 0.1rem 0.4rem;
    background: var(--or);
    font-weight: 600;
    border-radius: 0.25rem;
  }

  .content :global(.lead) {
    font-size: 1.1875rem;
    font-weight: 600;
  }
</style>
