---
import '../styles/global.css';
import sora400 from '@fontsource/sora/files/sora-latin-400-normal.woff2?url';
import sora800 from '@fontsource/sora/files/sora-latin-800-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo, { type SeoProps } from '../components/Seo.astro';
import { ADS } from '../config/ads';
import { SITE } from '../config/site';

type Props = SeoProps;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={sora800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sora400} as="font" type="font/woff2" crossorigin />
    <Seo {...Astro.props} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F5B800" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ADS.enabled && ADS.scriptSrc && <script is:inline async src={ADS.scriptSrc} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
