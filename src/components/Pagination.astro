---
interface Props {
  current: number;
  total: number;
  baseUrl: string;
}

const { current, total, baseUrl } = Astro.props;
const pageUrl = (page: number) => (page === 1 ? baseUrl : `${baseUrl}page/${page}/`);
const pages = Array.from({ length: total }, (_, index) => index + 1);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {current > 1 && (
        <a class="step" href={pageUrl(current - 1)} rel="prev">
          Précédent
        </a>
      )}
      <ol>
        {pages.map((page) => (
          <li>
            <a href={pageUrl(page)} aria-current={page === current ? 'page' : undefined} aria-label={`Page ${page}`}>
              {page}
            </a>
          </li>
        ))}
      </ol>
      {current < total && (
        <a class="step" href={pageUrl(current + 1)} rel="next">
          Suivant
        </a>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    place-items: center;
    min-width: 3rem;
    height: 3rem;
    padding-inline: 1rem;
    background: var(--blanc);
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
  }

  a:hover,
  a[aria-current='page'] {
    background: var(--noir);
    color: var(--blanc);
  }
</style>
