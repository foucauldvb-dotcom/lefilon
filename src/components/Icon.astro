---
interface Props {
  name: 'instagram' | 'tiktok' | 'facebook' | 'rss' | 'arrow' | 'whatsapp' | 'x' | 'link' | 'search';
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.25" cy="6.75" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'tiktok' && (
      <>
        <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5" />
        <path d="M14 3c0 2.8 2.2 5 5 5" />
      </>
    )
  }
  {name === 'facebook' && <path d="M17 3h-2.5A3.5 3.5 0 0 0 11 6.5V9H8v3.5h3V21h3.5v-8.5H17l.5-3.5h-3V7a1 1 0 0 1 1-1H17z" />}
  {
    name === 'rss' && (
      <>
        <circle cx="5" cy="19" r="1.5" fill="currentColor" />
        <path d="M4 11a9 9 0 0 1 9 9" />
        <path d="M4 4a16 16 0 0 1 16 16" />
      </>
    )
  }
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {
    name === 'whatsapp' && (
      <>
        <path d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.6-4.3A8.5 8.5 0 1 1 20.5 11.5z" />
        <path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8a4 4 0 0 1-2.3-2.3l.8-1-1-2z" />
      </>
    )
  }
  {name === 'x' && <path d="M4.5 4l15 16M19.5 4l-15 16" />}
  {
    name === 'link' && (
      <>
        <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" />
        <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
      </>
    )
  }
  {
    name === 'search' && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="M16 16l4.5 4.5" />
      </>
    )
  }
</svg>
