---
import type { Article } from '../lib/articles';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles: Article[];
  heading?: 'h2' | 'h3';
  showDescription?: boolean;
}

const { articles, heading = 'h3', showDescription = false } = Astro.props;
---

<ul class="grid">
  {
    articles.map((article) => (
      <li>
        <ArticleCard article={article} heading={heading} showDescription={showDescription} />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
