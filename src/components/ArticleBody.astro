---
import { ADS } from '../config/ads';
import { typoHtml } from '../lib/typo';
import AdSlot from './AdSlot.astro';

// Rend le texte de l'article et insère l'emplacement pub "milieu" après le paragraphe central.
// Les images du texte occupent au plus la largeur de la colonne (45rem) : on le précise au navigateur.
// La typographie française (espaces insécables) est appliquée ici, pas dans les fichiers Markdown.
const html = typoHtml(await Astro.slots.render('default')).replace(
  /(<img\b[^>]*?\ssizes=")[^"]*(")/g,
  '$1(min-width: 48rem) 45rem, 100vw$2',
);

let before = html;
let after = '';

if (ADS.enabled) {
  const ends = [...html.matchAll(/<\/p>/g)].map((match) => match.index + match[0].length);
  if (ends.length >= 4) {
    const cut = ends[Math.floor(ends.length / 2) - 1];
    before = html.slice(0, cut);
    after = html.slice(cut);
  }
}
---

<div class="prose">
  <Fragment set:html={before} />
  {after && <AdSlot position="milieu" />}
  {after && <Fragment set:html={after} />}
</div>

<style is:global>
  .prose {
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .prose > * + * {
    margin-top: 1.5rem;
  }

  .prose h2 {
    margin-top: 2.75rem;
    font-size: clamp(1.375rem, 4vw, 1.75rem);
  }

  .prose h3 {
    margin-top: 2rem;
    font-size: 1.25rem;
  }

  .prose a {
    font-weight: 600;
    text-decoration-color: var(--or);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose img {
    width: 100%;
    max-height: 34rem;
    object-fit: cover;
    border-radius: var(--rayon);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }

  .prose li + li {
    margin-top: 0.5rem;
  }

  .prose blockquote {
    margin-inline: 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 4px solid var(--or);
    font-weight: 600;
  }
</style>
