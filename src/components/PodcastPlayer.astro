---
import { PODCAST_SIZES, podcastPlayerUrl, type PodcastLayout } from '../config/podcast';

interface Props {
  // horizontal : blocs larges (accueil). vertical : colonne étroite (fin d'article).
  layout: PodcastLayout;
}

const { layout } = Astro.props;
const playerUrl = podcastPlayerUrl(layout);
const { width, height } = PODCAST_SIZES[layout];
---

<aside class:list={['podcast', `podcast--${layout}`]} aria-labelledby="podcast-title" data-pagefind-ignore>
  <div class="text">
    <h2 id="podcast-title">Le Filon, le podcast</h2>
    <p>Les pépites de la semaine, à écouter.</p>
  </div>
  {/* Lecteur Soundcast intégré directement : il contacte Soundcast et Google Fonts à l'affichage (voir la politique de confidentialité). */}
  <div class="player">
    <iframe
      src={playerUrl}
      title="Lecteur du podcast Le Filon"
      width={width}
      height={height}
      loading="lazy"></iframe>
  </div>
</aside>

<style>
  .podcast {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem 1.5rem;
    background: var(--blanc);
    border: 2px solid var(--noir);
    border-radius: var(--rayon);
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  h2::after {
    content: '.';
    color: var(--or);
  }

  .text p {
    margin-top: 0.5rem;
    color: var(--gris);
  }

  .player {
    display: flex;
    flex-direction: column;
  }

  /* Les dimensions viennent des attributs width/height ; le lecteur ne dépasse jamais son bloc */
  iframe {
    display: block;
    max-width: 100%;
    border: 0;
  }

  .podcast--vertical .player {
    align-items: center;
  }

  @media (min-width: 48rem) {
    .podcast {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding: 2.5rem 3rem;
    }

    .podcast--horizontal .player {
      flex: 0 1 34rem;
    }
  }
</style>
