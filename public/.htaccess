# Le Filon - hébergement mutualisé OVH (Apache)

Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# --- HTTPS forcé et www.lefilon.media -> lefilon.media (une seule redirection 301) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{SERVER_PORT} ^80$ [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://lefilon.media%{REQUEST_URI} [R=301,L]

  # Dossier demandé sans barre finale (/a-propos) : redirection directe vers /a-propos/.
  # Sans cette règle, Apache s'en charge mais ajoute ":443" à l'adresse.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ https://lefilon.media/$1/ [R=301,L]
</IfModule>

# --- Types MIME ---
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/wasm .wasm
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Compression gzip/deflate ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml application/wasm
</IfModule>

# --- Cache navigateur ---
# Les fichiers de /_astro/ (noms hachés) sont mis en cache 1 an par public/_astro/.htaccess.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/xml "access plus 10 minutes"
  ExpiresByType application/rss+xml "access plus 10 minutes"
  ExpiresByType text/plain "access plus 10 minutes"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/avif "access plus 1 week"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- En-têtes de sécurité ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # HTTPS imposé pendant un an. Ni includeSubDomains ni preload : cela reste réversible.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Content-Security-Policy
  # - script-src : fichiers du site, WebAssembly de la recherche ('wasm-unsafe-eval' est indispensable
  #   à Pagefind, vérifié en test), et les scripts intégrés
  #   aux pages, autorisés par empreinte : le marqueur de script-src est remplacé au build
  #   (integrations/csp.mjs).
  # - style-src 'unsafe-inline' : le CSS est intégré au HTML pour la performance.
  # - À ÉLARGIR le jour où la publicité est activée (AdSense, puis Prebid / Google Ad Manager) :
  #   script-src, img-src, connect-src et frame-src devront autoriser les domaines de la régie.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval' __SCRIPT_HASHES__; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>
